{
  "name": "@schoolkit/client",
  "version": "0.1.0",
  "description": "TypeScript client for the Korean NEIS Open API and Comcigan school timetables",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./neis": {
      "types": "./dist/neis/index.d.ts",
      "import": "./dist/neis/index.js"
    },
    "./timetable": {
      "types": "./dist/timetable/index.d.ts",
      "import": "./dist/timetable/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["neis", "school", "timetable", "korea", "education", "comcigan"]
}

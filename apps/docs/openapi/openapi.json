        "properties": {
          "name": {
            "examples": [
              "TimeForSchool"
            ],
            "type": "string"
          },
          "version": {
            "examples": [
              "0.0.1"
            ],
            "type": "string"
          },
          "docs": {
            "examples": [
              "/docs"
            ],
            "type": "string"
          },
          "openapi": {
            "examples": [
              "/docs/json"
            ],
            "type": "string"
          }
        },
        "$id": "#/components/schemas/ApiMeta"
      },
      "ApiError": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "const": false,
            "type": "boolean"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "patternProperties": {
                  "^(.*)$": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "$id": "#/components/schemas/ApiError"
      },

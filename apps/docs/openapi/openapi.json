{
  "openapi": "3.0.3",
  "info": {
    "title": "TimeForSchool API",
    "description": "TimeForSchool wraps the Korean **NEIS Open API** (school info, classes, meals, calendar) and **Comcigan** (weekly class timetables).\n\n### School identifier\nUse **either** `schoolname` **or** `schoolcode` (NEIS 7-digit code)—never both. No endpoint defaults to a particular school; `GET /school` requires `schoolname`.\n\n### Dates\n`startdate` / `enddate` use **YYYYMMDD** (e.g. `20250526`).\n\n### Errors\nFailed requests return `{ ok: false, error: { code, message, details? } }` with an appropriate HTTP status.",
    "version": "0.0.1"
  },
  "tags": [
    {
      "name": "Meta",
      "description": "Service metadata"
    },
    {
      "name": "School",
      "description": "NEIS school profile"
    },
    {
      "name": "Classes",
      "description": "Class numbers by grade"
    },
    {
      "name": "Timetable",
      "description": "Weekly timetable (Comcigan)"
    },
    {
      "name": "Lunch",
      "description": "Meal menus (NEIS)"
    },
    {
      "name": "Schedule",
      "description": "School calendar (NEIS)"
    }
  ],
  "servers": [
    {
      "url": "https://api.timefor.school",
      "description": "Production"
    },
    {
      "url": "http://localhost:8000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "API info",
        "description": "Service name, version, and links to interactive documentation.",
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiMeta"
                }
              }
            }
          }
        },
        "operationId": "getIndex"
      }
    },
    "/school": {
      "get": {
        "tags": [
          "School"
        ],
        "summary": "Search schools by name",
        "description": "Returns all NEIS school records matching schoolname (required).",
        "parameters": [
          {
            "name": "schoolname",
            "in": "query",
            "required": true,
            "schema": {
              "minLength": 1,
              "description": "Korean school name as registered in NEIS (e.g. 목운중학교). Required on GET /school.",
              "examples": [
                "목운중학교"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchoolInfoList"
                }
              }
            }
          },
          "400": {
            "description": "Response for status 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Response for status 404",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Response for status 502",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "operationId": "getSchool"
      }
    },
    "/classes": {
      "get": {
        "tags": [
          "Classes"
        ],
        "summary": "List class numbers for a grade",
        "description": "Returns sorted class names (반) for the given school and grade using NEIS classInfo.",
        "parameters": [
          {
            "name": "schoolname",
            "in": "query",
            "required": false,
            "schema": {
              "minLength": 1,
              "description": "Korean school name as registered in NEIS (e.g. 목운중학교). Required on GET /school.",
              "examples": [
                "목운중학교"
              ],
              "type": "string"
            }
          },
          {
            "name": "schoolcode",
            "in": "query",
            "required": false,
            "schema": {
              "pattern": "^\\d{7}$",
              "description": "NEIS standard school code (SD_SCHUL_CODE), 7 digits.",
              "examples": [
                "7010208"
              ],
              "type": "string"
            }
          },
          {
            "name": "grade",
            "in": "query",
            "required": true,
            "schema": {
              "minimum": 1,
              "maximum": 6,
              "description": "Grade level (학년).",
              "examples": [
                1
              ],
              "anyOf": [
                {
                  "format": "numeric",
                  "default": 0,
                  "type": "string"
                },
                {
                  "minimum": 1,
                  "maximum": 6,
                  "description": "Grade level (학년).",
                  "examples": [
                    1
                  ],
                  "type": "number"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassList"
                }
              }
            }
          },
          "400": {
            "description": "Response for status 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Response for status 404",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Response for status 502",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "operationId": "getClasses"
      }
    },
    "/timetable": {
      "get": {
        "tags": [
          "Timetable"
        ],
        "summary": "Weekly class timetable",
        "description": "Fetches the class schedule from Comcigan. Provide schoolname, or schoolcode alone (name is resolved via NEIS). week: 0 = this week, 1 = next week. Most periods have `replaced: false` and `original: null`; when a period was substituted, `replaced` is true and `original` is the class before the change.",
        "parameters": [
          {
            "name": "schoolname",
            "in": "query",
            "required": false,
            "schema": {
              "minLength": 1,
              "description": "Korean school name as registered in NEIS (e.g. 목운중학교). Required on GET /school.",
              "examples": [
                "목운중학교"
              ],
              "type": "string"
            }
          },
          {
            "name": "schoolcode",
            "in": "query",
            "required": false,
            "schema": {
              "pattern": "^\\d{7}$",
              "description": "NEIS standard school code (SD_SCHUL_CODE), 7 digits.",
              "examples": [
                "7010208"
              ],
              "type": "string"
            }
          },
          {
            "name": "grade",
            "in": "query",
            "required": true,
            "schema": {
              "minimum": 1,
              "maximum": 6,
              "description": "Grade level (학년).",
              "examples": [
                1
              ],
              "anyOf": [
                {
                  "format": "numeric",
                  "default": 0,
                  "type": "string"
                },
                {
                  "minimum": 1,
                  "maximum": 6,
                  "description": "Grade level (학년).",
                  "examples": [
                    1
                  ],
                  "type": "number"
                }
              ]
            }
          },
          {
            "name": "classno",
            "in": "query",
            "required": true,
            "schema": {
              "minimum": 1,
              "maximum": 30,
              "description": "Class number within the grade (반).",
              "examples": [
                3
              ],
              "anyOf": [
                {
                  "format": "numeric",
                  "default": 0,
                  "type": "string"
                },
                {
                  "minimum": 1,
                  "maximum": 30,
                  "description": "Class number within the grade (반).",
                  "examples": [
                    3
                  ],
                  "type": "number"
                }
              ]
            }
          },
          {
            "name": "week",
            "in": "query",
            "required": false,
            "schema": {
              "minimum": 0,
              "maximum": 1,
              "default": 0,
              "description": "0 = current week, 1 = next week.",
              "anyOf": [
                {
                  "format": "numeric",
                  "default": 0,
                  "type": "string"
                },
                {
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0,
                  "description": "0 = current week, 1 = next week.",
                  "type": "number"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimetableResponse"
                }
              }
            }
          },
          "400": {
            "description": "Response for status 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Response for status 404",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Response for status 409",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Response for status 502",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "operationId": "getTimetable"
      }
    },
    "/lunch": {
      "get": {
        "tags": [
          "Lunch"
        ],
        "summary": "Meal menus for a date range",
        "description": "Returns NEIS mealServiceDietInfo rows. Parentheses are stripped from dish names; HTML line breaks become newlines.",
        "parameters": [
          {
            "name": "schoolname",
            "in": "query",
            "required": false,
            "schema": {
              "minLength": 1,
              "description": "Korean school name as registered in NEIS (e.g. 목운중학교). Required on GET /school.",
              "examples": [
                "목운중학교"
              ],
              "type": "string"
            }
          },
          {
            "name": "schoolcode",
            "in": "query",
            "required": false,
            "schema": {
              "pattern": "^\\d{7}$",
              "description": "NEIS standard school code (SD_SCHUL_CODE), 7 digits.",
              "examples": [
                "7010208"
              ],
              "type": "string"
            }
          },
          {
            "name": "startdate",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^\\d{8}$",
              "description": "Calendar date in YYYYMMDD format (e.g. 20250526).",

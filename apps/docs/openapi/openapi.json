    "/timetable": {
      "get": {
        "tags": [
          "Timetable"
        ],
        "summary": "Weekly class timetable",
        "description": "Fetches the class schedule. Default `source=auto` calls Comcigan and NEIS in parallel and merges them per period: whichever side has a subject is used, the shorter name wins when both do, and missing weekdays/periods fill from the other source. Empty or cancelled Comcigan periods still fill from NEIS. NEIS Saturday is ignored (stale 토요휴업일). Pin `source=comcigan` or `source=neis` to hit a single upstream. Provide schoolname, or schoolcode alone. week: 0 = this week, 1 = next week. Comcigan substitutions use `replaced` + `original`. `day_time` always comes from Comcigan and is blank when Comcigan has none. `teacher` also stays blank when Comcigan has no data. `week_start` is the KST Monday the response describes. Each period carries `cancelled` and `makeup` flags. `days` (index-aligned with `timetable`) marks holidays and lists the grade's NEIS calendar events; it is fetched in parallel and omitted if the calendar lookup fails.",
        "parameters": [
          {
            "name": "schoolname",
            "in": "query",
            "required": false,
            "schema": {
              "minLength": 1,
              "description": "Korean school name as registered in NEIS (e.g. 양정고등학교). Required on GET /school.",
              "examples": [
                "양정고등학교"
              ],
              "type": "string"
            }
          },
          {
            "name": "schoolcode",
            "in": "query",
            "required": false,
            "schema": {
              "pattern": "^\\d{7}$",
              "description": "NEIS standard school code (SD_SCHUL_CODE), 7 digits.",
              "examples": [
                "7010208"
              ],
              "type": "string"
            }
          },
          {
            "name": "grade",
            "in": "query",
            "required": true,
            "schema": {
              "minimum": 1,
              "maximum": 6,
              "description": "Grade level (학년).",
              "examples": [
                1
              ],
              "anyOf": [
                {
                  "format": "numeric",
                  "default": 0,
                  "type": "string"
                },
                {
                  "minimum": 1,
                  "maximum": 6,
                  "description": "Grade level (학년).",
                  "examples": [
                    1
                  ],
                  "type": "number"
                }
              ]
            }
          },
          {
            "name": "classno",
            "in": "query",
            "required": true,
            "schema": {
              "minimum": 1,
              "maximum": 30,
              "description": "Class number within the grade (반).",
              "examples": [
                3
              ],
              "anyOf": [
                {
                  "format": "numeric",
                  "default": 0,
                  "type": "string"
                },
                {
                  "minimum": 1,
                  "maximum": 30,
                  "description": "Class number within the grade (반).",
                  "examples": [
                    3
                  ],
                  "type": "number"
                }
              ]
            }
          },
          {
            "name": "week",
            "in": "query",
            "required": false,
            "schema": {
              "minimum": 0,
              "maximum": 1,
              "default": 0,
              "description": "0 = current week, 1 = next week.",
              "anyOf": [
                {
                  "format": "numeric",
                  "default": 0,
                  "type": "string"
                },
                {
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0,
                  "description": "0 = current week, 1 = next week.",
                  "type": "number"
                }
              ]
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "auto",
                "comcigan",
                "neis"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimetableResponse"
                }
              }
            }
          },
          "400": {
            "description": "Response for status 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Response for status 404",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Response for status 409",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Response for status 502",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "operationId": "getTimetable"
      }
    },

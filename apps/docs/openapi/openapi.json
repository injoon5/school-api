                1
              ],
              "anyOf": [
                {
                  "format": "numeric",
                  "default": 0,
                  "type": "string"
                },
                {
                  "minimum": 1,
                  "maximum": 6,
                  "description": "Grade level (학년).",
                  "examples": [
                    1
                  ],
                  "type": "number"
                }
              ]

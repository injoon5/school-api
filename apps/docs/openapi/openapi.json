    "/schedule": {
      "get": {
        "tags": [
          "Schedule"
        ],
        "summary": "School calendar events",
        "description": "Returns NEIS SchoolSchedule rows between startdate and enddate (inclusive), in their raw NEIS shape. Optional `grade` keeps only rows whose matching `*_GRADE_EVENT_YN` column (`ONE_GRADE_EVENT_YN` for grade 1 … `SIX_GRADE_EVENT_YN` for grade 6) is `Y`. An empty result, with or without `grade`, is `404 NEIS_DATA_NOT_FOUND`.",
        "parameters": [
          {
            "name": "schoolname",
            "in": "query",
            "required": false,
            "schema": {
              "minLength": 1,
              "description": "Korean school name as registered in NEIS (e.g. 양정고등학교). Required on GET /school.",
              "examples": [
                "양정고등학교"
              ],
              "type": "string"
            }
          },
          {
            "name": "schoolcode",
            "in": "query",
            "required": false,
            "schema": {
              "pattern": "^\\d{7}$",
              "description": "NEIS standard school code (SD_SCHUL_CODE), 7 digits.",
              "examples": [
                "7010208"
              ],
              "type": "string"
            }
          },
          {
            "name": "startdate",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^\\d{8}$",
              "description": "Calendar date in YYYYMMDD format (e.g. 20250526).",
              "examples": [
                "20250526"
              ],
              "type": "string"
            }
          },
          {
            "name": "enddate",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^\\d{8}$",
              "description": "Calendar date in YYYYMMDD format (e.g. 20250526).",
              "examples": [
                "20250526"
              ],
              "type": "string"
            }
          },
          {
            "name": "grade",
            "in": "query",
            "required": false,
            "schema": {
              "minimum": 1,
              "maximum": 6,
              "description": "Optional grade level (학년). When set, only rows whose matching `*_GRADE_EVENT_YN` is `Y` are returned.",
              "examples": [
                1
              ],
              "anyOf": [
                {
                  "format": "numeric",
                  "default": 0,
                  "type": "string"
                },
                {
                  "minimum": 1,
                  "maximum": 6,
                  "description": "Optional grade level (학년). When set, only rows whose matching `*_GRADE_EVENT_YN` is `Y` are returned.",
                  "examples": [
                    1
                  ],
                  "type": "number"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleList"
                }
              }
            }
          },
          "400": {
            "description": "Response for status 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {

{
  "name": "@timeforschool/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run openapi:generate -w @timeforschool/docs",
    "build": "next build",
    "dev": "next dev --port 3000",
    "start": "next start",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "^16.9.1",
    "fumadocs-mdx": "^15.0.9",
    "fumadocs-openapi": "^10.9.0",
    "fumadocs-ui": "^16.9.1",
    "lucide-react": "^0.511.0",
    "next": "^16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.15.21",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}

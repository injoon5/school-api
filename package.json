{
  "name": "schoolkit-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @schoolkit/client && tsc",
    "build:client": "npm run build -w @schoolkit/client",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx src/test/compare.ts && tsx src/test/yangjeong-1-3.ts && tsx src/test/compare-timefor.ts",
    "test:production": "tsx src/test/compare-timefor.ts",
    "vercel:dev": "vercel dev",
    "vercel:deploy": "vercel deploy --prod"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.0",
    "@elysiajs/swagger": "^1.3.1",
    "@schoolkit/client": "workspace:*",
    "elysia": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}

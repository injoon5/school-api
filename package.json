{
  "name": "timeforschool-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @timeforschool/client && tsc",
    "build:client": "npm run build -w @timeforschool/client",
    "build:docs": "npm run build -w @timeforschool/docs",
    "dev:docs": "npm run dev -w @timeforschool/docs",
    "openapi:export": "npm run build:client && tsx scripts/export-openapi.ts",
    "openapi:sync": "npm run openapi:export && npm run openapi:generate -w @timeforschool/docs",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx src/test/timetable-merge.ts && tsx src/test/compare.ts && tsx src/test/yangjeong-1-3.ts && tsx src/test/neis-timetable.ts",
    "vercel:dev": "vercel dev",
    "vercel:deploy": "vercel deploy --prod"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.0",
    "@elysiajs/openapi": "^1.4.15",
    "@timeforschool/client": "workspace:*",
    "elysia": "^1.4.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
